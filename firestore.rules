rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unexpected collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.fullName is string &&
             data.fullName.size() >= 1 &&
             data.fullName.size() <= 100 &&
             data.email is string &&
             data.email.size() <= 120 &&
             (!('currentLocationName' in data) || (data.currentLocationName is string && data.currentLocationName.size() <= 200)) &&
             (!('currentLocationLat' in data) || (data.currentLocationLat is number)) &&
             (!('currentLocationLng' in data) || (data.currentLocationLng is number)) &&
             (!('mobilityProfile' in data) || (data.mobilityProfile in ['general', 'wheelchair', 'elderly', 'visual_assistance', 'walking_difficulty', 'temporary_injury'])) &&
             (!('mobilityPreferences' in data) || (data.mobilityPreferences is map)) &&
             (!('onboardingCompleted' in data) || (data.onboardingCompleted is bool)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidIncidentReport(data, userId) {
      return data.id is string &&
             data.id.size() >= 1 &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 100 &&
             data.description is string &&
             data.description.size() >= 1 &&
             data.description.size() <= 5000 &&
             data.status in ['draft_created', 'ready_for_review', 'opened_official_channel', 'submitted_confirmed'] &&
             (!('incidentDate' in data) || (data.incidentDate is string && data.incidentDate.size() <= 50)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 300)) &&
             (!('latitude' in data) || (data.latitude is number)) &&
             (!('longitude' in data) || (data.longitude is number)) &&
             (!('preferredLanguage' in data) || (data.preferredLanguage in ['en', 'ta'])) &&
             (!('desiredAssistance' in data) || (data.desiredAssistance is string && data.desiredAssistance.size() <= 300)) &&
             (!('complaintDraft' in data) || (data.complaintDraft is string && data.complaintDraft.size() <= 10000)) &&
             (!('receivingAuthority' in data) || (data.receivingAuthority is string && data.receivingAuthority.size() <= 200)) &&
             (!('officialPortalUrl' in data) || (data.officialPortalUrl is string && data.officialPortalUrl.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Users Collection: Private user profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user list queries are disallowed to protect user privacy
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // Subcollection: Confidential Incident Reports & Complaint Drafts
      match /reports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reportId) && isValidIncidentReport(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(reportId) && isValidIncidentReport(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(reportId);
      }
    }
  }
}
